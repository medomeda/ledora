# --- Démonstration ---
# Mode test : bandeau « Version de démonstration », comptes fictifs sur la connexion, page /guide, données simulées chargées
# dans une base vide. Développement : actif (0 pour le couper). Production : actif seulement avec 1.
LEADORA_DEMO_MODE=1
# Autorise « Réinitialiser la démonstration » (administration) et POST /api/demo/reset (secret CRON_SECRET) en mode test.
# LEADORA_ALLOW_DEMO_RESET=1
# CRON_SECRET=
# Mettre à 1 uniquement derrière un reverse proxy de confiance (lecture de X-Forwarded-For pour la limitation par IP).
TRUST_PROXY=0
# --- IA et modules « au chaud » ---
# IA dans la création de quiz (génération, reformulations, ajustements) : 1 par défaut, 0 pour la désactiver.
LEADORA_FEATURE_AI=1
# Modules au chaud (désactivés par défaut) : 1 pour réactiver puis redémarrer.
LEADORA_FEATURE_ASSISTANT=0
LEADORA_FEATURE_PUBLICATIONS=0
# Fournisseur d'IA : « mock » = simulation locale.
AI_PROVIDER=mock

# --- Persistance ---
# PostgreSQL (développement : `npm run db:up` démarre un conteneur Docker sur le port 5440). Sans cette variable,
# PGlite (PostgreSQL embarqué, sans installation) est utilisé : données dans .data/pglite.
# DATABASE_URL=postgres://leadora:leadora@localhost:5440/leadora
# Taille du pool de connexions PostgreSQL (défaut 10).
# DATABASE_POOL=10
# Charge le jeu de démonstration sur une base vide : 1 par défaut hors production, 0 en production.
# LEADORA_SEED_DEMO=1

# --- Authentification (Better Auth) ---
# Secret de signature des cookies de session : 32 caractères minimum, OBLIGATOIRE en production.
# Générer : node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
# BETTER_AUTH_SECRET=
# URL publique de l'application (liens, contrôle d'origine, référencement). En production : https, sans port.
# BETTER_AUTH_URL=http://localhost:3300
# Premier administrateur d'une plateforme vide (déploiement) : 12 caractères minimum ; à retirer après la première connexion.
# LEADORA_BOOTSTRAP_ADMIN_EMAIL=
# LEADORA_BOOTSTRAP_ADMIN_PASSWORD=
# LEADORA_BOOTSTRAP_ADMIN_NAME=

# --- Emails ---
# Aucun fournisseur branché : les emails sont consignés dans la console et les liens affichés à l'écran (mode simulé).
# MAIL_PROVIDER=
