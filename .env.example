# --- Phase données simulées ---
# Affiche les raccourcis de comptes de démonstration sur la page de connexion (0 pour les masquer).
LEADORA_DEMO_MODE=1
# 0 = ne pas écrire la base simulée dans .data/leadora-demo.json (mémoire seulement).
LEADORA_DEMO_PERSIST=1
# Mettre à 1 uniquement derrière un reverse proxy de confiance (lecture de X-Forwarded-For pour la limitation par IP).
TRUST_PROXY=0
# --- Modules « au chaud » (désactivés par défaut, hors du cœur de la plateforme) ---
# 1 pour réactiver le calendrier de publications / l'Assistant IA (puis redémarrer).
LEADORA_FEATURE_PUBLICATIONS=0
LEADORA_FEATURE_AI=0
# Fournisseur d'IA (si l'Assistant IA est activé) : « mock » = simulation locale.
AI_PROVIDER=mock

# --- Phase persistance (à venir) ---
# DATABASE_URL=postgres://...
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=
